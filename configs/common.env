# Controller listens on 0.0.0.0:8000 inside the container (Dockerfile CMD).
LLAMA_SERVER_BIN=/usr/local/bin/llama-server
LOAD_TIMEOUT_SEC=300
UNLOAD_TIMEOUT_SEC=30

# llama-server --fit: honor requested ctx/batch; OOM becomes ERROR instead of silent shrink
LLAMA_FIT=off

# Internal llama-server bind (not published to the host)
HOST=127.0.0.1
PORT=8080
