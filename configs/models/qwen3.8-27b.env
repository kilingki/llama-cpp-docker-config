# Example profile: Qwen3.8-27B GGUF Q4_K_M
# Flags map 1:1 to llama-server CLI (llama.cpp b10453+). No model-specific code.

MODEL_PATH=/models/Qwen3.8-27B-Q4_K_M.gguf
MODEL_NAME=qwen3.8-27b

# Keep default context conservative; raise via this file for 64K/128K/192K/262K benches
CONTEXT_SIZE=32768

# Full GPU offload when possible
GPU_LAYERS=all

CACHE_TYPE_K=f16
CACHE_TYPE_V=f16
FLASH_ATTN=on

BATCH_SIZE=2048
UBATCH_SIZE=512
THREADS=-1
PARALLEL=1

# Internal llama-server bind (controller proxies; do not publish this port)
HOST=127.0.0.1
PORT=8080

# Optional: set a GGUF mmproj path to enable VLM. Empty = text-only.
MMPROJ_PATH=

# llama-server --jinja / --no-jinja
JINJA=on
